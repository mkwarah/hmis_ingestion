# Copy to .env and adjust. Read by ingestion_config.yml via ${VAR:-default}.

# DHIS2 source (public demo defaults)
DHIS2_BASE_URL=https://play.im.dhis2.org/stable-2-43-2-1
DHIS2_USERNAME=admin
DHIS2_PASSWORD=district

# MinIO data lake
MINIO_ENDPOINT=localhost:9100
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false
MINIO_BUCKET=hmis-datalake

# ClickHouse warehouse (gold marts); local teaching defaults
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8124
CLICKHOUSE_USER=hmis
CLICKHOUSE_PASSWORD=hmis

# Folder containing dataset_ingestion.py (used by prefect.yaml pull step)
HMIS_PROJECT_DIR=

# dbt, run by the pipeline after ingestion. Point at dbt in its own venv,
# e.g. /home/<you>/venvs/hmis-dbt/bin/dbt. DuckDB file: keep it off OneDrive.
DBT_EXECUTABLE=dbt
HMIS_DUCKDB_PATH=~/hmis-data/hmis_lake.duckdb
