# Copy to .env and adjust. Read by ingestion_config.yml via ${VAR:-default}.

# DHIS2 source (public demo defaults)
DHIS2_BASE_URL=https://play.im.dhis2.org/stable-2-43-2-1
DHIS2_USERNAME=admin
DHIS2_PASSWORD=district

# MinIO data lake
MINIO_ENDPOINT=localhost:9100
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false
MINIO_BUCKET=hmis-datalake

# ClickHouse warehouse (gold marts); local teaching defaults
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8124
CLICKHOUSE_USER=hmis
CLICKHOUSE_PASSWORD=hmis

# Folder containing dataset_ingestion.py (used by prefect.yaml pull step)
HMIS_PROJECT_DIR=

# dbt, run by the pipeline after ingestion. Point at dbt in its own venv,
# e.g. /home/<you>/venvs/hmis-dbt/bin/dbt. DuckDB file: keep it off OneDrive.
DBT_EXECUTABLE=dbt
HMIS_DUCKDB_PATH=~/hmis-data/hmis_lake.duckdb

# Metabase dashboards (metabase/setup_metabase.py); local teaching defaults
MB_URL=http://localhost:3010
MB_ADMIN_EMAIL=admin@hmis.local
MB_ADMIN_PASSWORD=HmisAdmin2026!
# Read-only ClickHouse user Metabase connects as (gold only)
CLICKHOUSE_BI_PASSWORD=metabase

# Secret key for hashing personal data (storedBy) in dbt staging: at least
# 16 characters, keep it private, and do not change it casually (every hash
# changes). Generate one with: python -c "import secrets;print(secrets.token_hex(32))"
HMIS_HASH_SALT=

# Alert emails on failed runs. Defaults go to the local Mailpit inbox
# (http://localhost:8025). Office 365 example: SMTP_HOST=smtp.office365.com,
# SMTP_PORT=587, SMTP_STARTTLS=true, SMTP_USERNAME/SMTP_PASSWORD = the account.
ALERTS_ENABLED=true
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_STARTTLS=false
SMTP_USERNAME=
SMTP_PASSWORD=
ALERT_EMAIL_FROM=hmis-pipeline@localhost
ALERT_EMAIL_TO=data-team@localhost
